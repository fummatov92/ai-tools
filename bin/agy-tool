        d_ls.add_argument("--remote", default=None, help="Rclone remote nomi")

        # drive upload
        d_up = drive_sub.add_parser("upload", aliases=["up", "push"], help="Lokal fayl/jildni Google Drive ga yuklash")
        d_up.add_argument("local_path", help="Lokal fayl yoki papka yo'li")
        d_up.add_argument("remote_path", nargs="?", default="", help="Drive dagi manzil yo'li")
        d_up.add_argument("--remote", default=None, help="Rclone remote nomi")

        # drive download
        d_down = drive_sub.add_parser("download", aliases=["down", "pull"], help="Google Drive dan fayl/jildni yuklab olish")
        d_down.add_argument("remote_path", help="Drive dagi fayl yoki papka yo'li")
        d_down.add_argument("local_path", nargs="?", default=None, help="Lokal saqlash yo'li")
        d_down.add_argument("--remote", default=None, help="Rclone remote nomi")

        # drive sync
        d_sync = drive_sub.add_parser("sync", help="Lokal va Google Drive orasida sinxronizatsiya")
        d_sync.add_argument("local_dir", help="Lokal papka yo'li")
        d_sync.add_argument("remote_path", nargs="?", default="", help="Drive dagi manzil yo'li")
        d_sync.add_argument("--direction", choices=["up", "down"], default="up", help="Sinxron yo'nalishi (up: lokal->drive, down: drive->lokal)")
        d_sync.add_argument("--dry-run", action="store_true", help="Sinov rejimi (amalda o'zgartirishsiz)")
        d_sync.add_argument("--remote", default=None, help="Rclone remote nomi")

        # drive mkdir
        d_mkdir = drive_sub.add_parser("mkdir", help="Google Drive da yangi jild yaratish")
        d_mkdir.add_argument("path", help="Yaratiluvchi jild yo'li")
        d_mkdir.add_argument("--remote", default=None, help="Rclone remote nomi")

        # drive quota
        d_quota = drive_sub.add_parser("quota", aliases=["about"], help="Google Drive xotira kvotasini ko'rish")
        d_quota.add_argument("--remote", default=None, help="Rclone remote nomi")

        # drive link
        d_link = drive_sub.add_parser("link", aliases=["share"], help="Google Drive dagi fayl havolasini olish")
        d_link.add_argument("path", help="Drive dagi fayl yo'li")
        d_link.add_argument("--remote", default=None, help="Rclone remote nomi")

    return parser


def main():
    raw_argv = list(sys.argv)
    filtered_argv, session_id, session_path = extract_session_flags(raw_argv)
    caller_cwd = os.environ.get("AGY_CALLER_CWD", os.getcwd())

    logger = get_logger()
    set_checkpoint_hook(lambda step, pct=None, detail=None: logger.checkpoint(step, pct, detail))

    result_captured = {"success": True, "error": None}

    def on_result(data, success=True, error=None):
        result_captured["success"] = success
        result_captured["error"] = error
        logger.set_result(success, error)

    set_result_hook(on_result)

    parser = build_parser()

    try:
        args = parser.parse_args(filtered_argv[1:])
    except SystemExit as se:
        if se.code != 0:
            logger.start_run(
                command="cli_parse_error",
                args=raw_argv[1:],
                session_id=session_id,
                session_path=session_path,
                caller_cwd=caller_cwd
            )
            logger.end_run(status="ERROR", error_detail=f"CLI parse error (exit code {se.code})")
        sys.exit(se.code)

    # Attach session context to args
    args.session_id = session_id
    args.session_path = session_path

    # Determine command
    if args.describe or not args.module:
        command = "--describe"
    else:
        command = f"{args.module} {getattr(args, 'action', '') or ''}".strip()

    logger.start_run(
        command=command,
        args=raw_argv[1:],
        session_id=session_id,
        session_path=session_path,
        caller_cwd=caller_cwd
    )

    exit_code = 0
    try:
        if args.describe or not args.module:
            capabilities = {
                "name": "ai-tools",
                "version": "2.0.0",
                "modules": {
                    "sys": sys_tool.get_sys_describe(),
                    "code": code_tool.get_code_describe(),
                    "secure": secure_tool.get_secure_describe(),
                    "debug": debug_tool.get_debug_describe(),
                    "doc": doc_tool.get_doc_describe(),
                    "media": media_tool.get_media_describe(),
                    "session": session_tool.get_session_describe(),
                    "super_media": super_media_tool.get_super_media_describe(),
                    "bot": bot_tool.get_bot_describe(),
                    "sender": sender_tool.get_sender_describe(),
                    "db": db_tool.get_db_describe(),
                    "drive": drive_tool.get_drive_describe()
                }
            }
            emit_result(capabilities)
            return

        if args.module == "sys":
            if args.action == "ports":
                sys_tool.run_sys_ports(args)
            elif args.action == "docker":
                sys_tool.run_sys_docker(args)
            elif args.action == "last-run":
                sys_tool.run_sys_last_run(args)
            elif args.action == "logs":
                sys_tool.run_sys_logs(args)
            elif args.action == "storage":
                sys_tool.run_sys_storage(args)
            elif args.action == "status" or not args.action:
                sys_tool.run_sys_status(args)
            else:
                emit_result(None, success=False, error=f"Noma'lum sys buyrug'i: {args.action}")
                exit_code = 1

        elif args.module == "code":
            if args.action == "blueprint":
                code_tool.run_code_blueprint(args)
            elif args.action == "endpoints":
                code_tool.run_code_endpoints(args)
            elif args.action == "symbols":
                code_tool.run_code_symbols(args)
            else:
                emit_result(None, success=False, error=f"Noma'lum code buyrug'i: {args.action}")
                exit_code = 1

        elif args.module == "secure":
            if args.action == "scan":
                secure_tool.run_secure_scan(args)
            elif args.action == "redact":
                secure_tool.run_secure_redact(args)
            else:
                emit_result(None, success=False, error=f"Noma'lum secure buyrug'i: {args.action}")
                exit_code = 1

        elif args.module == "debug":
            if args.action == "trace":
                debug_tool.run_debug_trace(args)
            elif args.action == "bot":
                debug_tool.run_bot_test(args)
            elif args.action == "check" or not args.action:
                debug_tool.run_debug_check(args)
            else:
                emit_result(None, success=False, error=f"Noma'lum debug buyrug'i: {args.action}")
                exit_code = 1

        elif args.module == "doc":
            doc_tool.run_doc_generate(args)

        elif args.module == "session":
            if args.action == "list" or not args.action:
                session_tool.run_session_list(args)
            elif args.action == "inspect":
                session_tool.run_session_inspect(args)
            elif args.action == "diff":
                session_tool.run_session_diff(args)
            elif args.action == "query":
                session_tool.run_session_query(args)
            elif args.action == "export":
                session_tool.run_session_export(args)
            else:
                if args.action and (len(args.action) >= 8 or "-" in args.action):
                    args.session_id_arg = args.action
                    session_tool.run_session_inspect(args)
                else:
                    emit_result(None, success=False, error=f"Noma'lum session buyrug'i: {args.action}")
                    exit_code = 1

        elif args.module == "media":
            if args.action == "video":
                media_tool.run_video(args)
            elif args.action == "audio":
                media_tool.run_audio(args)
            elif args.action == "image":
                media_tool.run_image(args)
            elif args.action == "archive":
                media_tool.run_archive(args)
            elif args.action == "text":
                media_tool.run_text(args)
            elif args.action == "pipeline" or not args.action:
                media_tool.run_pipeline(args)
            else:
                if os.path.exists(args.action):
                    args.path = args.action
                    media_tool.run_pipeline(args)
                else:
                    emit_result(None, success=False, error=f"Noma'lum media buyrug'i: {args.action}")
                    exit_code = 1

        elif args.module in ["super-media", "super_media"]:
            if args.action == "video":
                super_media_tool.run_super_video(args)
            elif args.action == "archive":
                super_media_tool.run_super_archive(args)
            elif args.action == "pipeline" or not args.action:
                super_media_tool.run_super_pipeline(args)
            else:
                if os.path.exists(args.action):
                    args.path = args.action
                    super_media_tool.run_super_pipeline(args)
                else:
                    emit_result(None, success=False, error=f"Noma'lum super-media buyrug'i: {args.action}")
                    exit_code = 1


        elif args.module == "stats":
            if args.action == "session":
                stats_tool.run_stats_session(args)
            elif args.action == "compare":
                stats_tool.run_stats_compare(args)
            elif args.action == "summary" or not args.action:
                stats_tool.run_stats_summary(args)
            else:
                args.target_session = args.action
                stats_tool.run_stats_session(args)

        elif args.module == "bot":
            handlers_dir = getattr(args, "dir", None) or os.environ.get("AGY_HANDLERS_DIR", "./handlers")
            if args.action == "add":
                bot_tool.add_handler(args.name, getattr(args, "type", "command"), getattr(args, "desc", ""), handlers_dir)
            elif args.action in ["remove", "rm"]:
                bot_tool.remove_handler(args.name, handlers_dir)
            elif args.action == "check":
                bot_tool.check_handlers(handlers_dir)
            elif args.action == "list" or not args.action:
                bot_tool.list_handlers(handlers_dir)
            else:
                emit_result(None, success=False, error=f"Noma'lum bot buyrug'i: {args.action}")
                exit_code = 1

        elif args.module in ["archive", "archiver"]:
            if args.action == "pack":
                archive_tool.pack_archive(args.source, output_path=args.output, clean=args.clean, exclude=args.exclude)
            elif args.action == "unpack":
                archive_tool.unpack_archive(args.archive, target_dir=args.target)
            elif args.action == "inspect":
                args.path = args.archive
                super_media_tool.run_super_archive(args)
            elif args.action and os.path.exists(args.action):
                args.path = args.action
                super_media_tool.run_super_archive(args)
            else:
                emit_result(None, success=False, error=f"Noma'lum archive buyrug'i: {args.action}")
                exit_code = 1

        elif args.module in ["sender", "send"]:
            if args.action in ["msg", "message", "text"]:
                sender_tool.run_send_msg(args)
            elif args.action in ["doc", "document", "file"]:
                sender_tool.run_send_doc(args)
            elif args.action in ["photo", "image", "pic"]:
                sender_tool.run_send_photo(args)
            elif args.action in ["live", "update-live"]:
                sender_tool.run_send_live(args)
            else:
                emit_result(None, success=False, error=f"Noma'lum sender buyrug'i: {args.action}")
                exit_code = 1

        elif args.module in ["file-send", "send-file"]:
            sender_tool.run_send_doc(args)

        elif args.module in ["db", "database"]:
            target_file = getattr(args, "file", None)
            fmt = getattr(args, "format", "table")
            top_n = getattr(args, "top", 50)
            db_type = getattr(args, "type", "auto")

            if args.action in ["inspect", "info", "analyze"] or (args.action and os.path.exists(args.action)):
                if not target_file and args.action and os.path.exists(args.action):
                    target_file = args.action
                db_tool.inspect_db_file(target_file, db_type=db_type, format_type=fmt, max_tables=top_n)
            elif args.action in ["tables", "list"]:
                db_tool.list_tables(target_file, db_type=db_type, format_type=fmt)
            elif args.action in ["dump", "export"]:
                out_path = getattr(args, "out", None)
                db_tool.run_db_dump(target_file, out_file=out_path, db_type=db_type)
            elif args.action in ["query", "exec"]:
                q = getattr(args, "query", "")
                db_tool.run_db_query(target_file, query=q, db_type=db_type, format_type=fmt)
            elif target_file:
                db_tool.inspect_db_file(target_file, db_type=db_type, format_type=fmt, max_tables=top_n)
            else:
                emit_result(None, success=False, error=f"Noma'lum db buyrug'i: {args.action}")
                exit_code = 1

        elif args.module in ["drive", "gdrive"]:
            if args.action == "status" or not args.action:
                drive_tool.run_drive_status(args)
            elif args.action in ["setup", "config", "auth"]:
                drive_tool.run_drive_setup(args)
            elif args.action in ["ls", "list"]:
                drive_tool.run_drive_ls(args)
            elif args.action in ["upload", "up", "push"]:
                drive_tool.run_drive_upload(args)
            elif args.action in ["download", "down", "pull"]:
                drive_tool.run_drive_download(args)
            elif args.action == "sync":
                drive_tool.run_drive_sync(args)
            elif args.action == "mkdir":
                drive_tool.run_drive_mkdir(args)
            elif args.action in ["quota", "about"]:
                drive_tool.run_drive_quota(args)
            elif args.action in ["link", "share"]:
                drive_tool.run_drive_link(args)
            else:
                emit_result(None, success=False, error=f"Noma'lum drive buyrug'i: {args.action}")
                exit_code = 1

        else:
            emit_result(None, success=False, error=f"Noma'lum modul: {args.module}")
            exit_code = 1

    except Exception as e:
        exit_code = 1
        emit_result(None, success=False, error=str(e))
    finally:
        status = "ERROR" if (exit_code != 0 or not result_captured["success"]) else "SUCCESS"
        error_detail = result_captured["error"]
        logger.end_run(status=status, error_detail=error_detail)
        if exit_code != 0:
            sys.exit(exit_code)


if __name__ == "__main__":
    main()
