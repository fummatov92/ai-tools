# ============================================================================
# AGY-TOOL (AI-TOOLS) COMPREHENSIVE CONFIGURATION TEMPLATE
# Developer Community Release
# Nusxalab oling: cp .env.example .env
# ============================================================================

# ----------------------------------------------------------------------------
# 1. CORE & TELEGRAM INTEGRATION (sender & bot modules)
# ----------------------------------------------------------------------------
# Telegram Bot Token (BotFather orqali olingan)
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ_example

# Xabarlar jo'natiladigan asosiy Telegram Chat ID
DEFAULT_CHAT_ID=your_telegram_chat_id_here

# Ruxsat etilgan foydalanuvchilar ID ro'yxati (vergul bilan)
ALLOWED_USER_IDS=123456789,987654321

# ----------------------------------------------------------------------------
# 2. PATH JAILING & SECURITY (secure & sys modules)
# ----------------------------------------------------------------------------
# Tool erkin kirishi mumkin bo'lgan kataloglar (Path Traversal himoyasi)
AGY_ALLOWED_DIRS=~/,./

# Port skanerlash oralig'i (agy-tool sys ports)
AGY_PORT_RANGE_START=8000
AGY_PORT_RANGE_END=9000

# Audit loglari katalogi va maksimal fayl hajmi (MB)
AGY_LOG_DIR=~/.local/state/agy-tool
AGY_MAX_LOG_SIZE_MB=5

# ----------------------------------------------------------------------------
# 3. CLOUD STORAGE & GOOGLE DRIVE (drive module)
# ----------------------------------------------------------------------------
# Rclone masofaviy disk nomi
GDRIVE_REMOTE_NAME=gdrive

# Asosiy ishchi papka ID si (Google Drive URL dagi oxirgi qism)
GDRIVE_ROOT_FOLDER_ID=your_gdrive_folder_id_here

# Masofaviy zaxira katalogi
GDRIVE_BACKUP_PATH=gdrive:/backups

# ----------------------------------------------------------------------------
# 4. MULTI-ENGINE DATABASE BACKUP & QUERY (db module)
# ----------------------------------------------------------------------------
# Ma'lumotlar bazasi ulanish URL parametrlari (agy-tool db dump/query)
# Postgres:
DB_POSTGRES_URL=postgresql://user:password@localhost:5432/dbname
# MySQL:
DB_MYSQL_URL=mysql://user:password@localhost:3306/dbname
# Redis:
DB_REDIS_URL=redis://localhost:6379/0
# MongoDB:
DB_MONGO_URL=mongodb://localhost:27017/dbname

# ----------------------------------------------------------------------------
# 5. MULTIMODAL & MEDIA PROCESSING (media & super-media modules)
# ----------------------------------------------------------------------------
# Vaqtinchalik audio/video/arxiv artefaktlari saqlanadigan papka
AGY_TEMP_MEDIA_DIR=~/Desktop/temp/media_artifacts
AGY_TEMP_SUPER_MEDIA_DIR=~/Desktop/temp/super_media_artifacts

# Perceptual dHash o'xshashlik chegarasi (default: 0.12 ya'ni 12%)
AGY_SUPER_MEDIA_THRESHOLD=0.12


# ----------------------------------------------------------------------------
# 7. SESSION MANAGEMENT (session module)
# ----------------------------------------------------------------------------
# AGY transkriptlari va sessiyalari saqlanadigan joy
AGY_BRAIN_DIR=~/.gemini/antigravity-cli/brain

# ----------------------------------------------------------------------------
# 8. SAFE PROBING SANDBOX & API CONTRACTS (doc module)
# ----------------------------------------------------------------------------
# Dev DB Sandbox katalogi
AGY_DEV_DB_SANDBOX_DIR=~/Desktop/temp/sandbox_db

# Probing paytida xavfsiz o'qiladigan jadvallar (GET-only whitelist)
AGY_PROBE_SAFE_TABLES=branches,categories,roles,regions,districts,cities,tags,currencies,tariffs,status_types

# Probing paytida qat'iy chetlab o'tiladigan (ignore) xavfli marshrutlar
AGY_API_IGNORE_PATTERNS=*payme*,*click*,*uzum*,*billing*,*webhook*,*sms*,*auth/login*,*checkout*
